# Optional dedicated Roadmaps backend. Never use Campus/Workspace credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Core catalogue, document extraction, OCR, graph and practice work without AI.
# No model or pricing is assumed current. Verify official provider terms/rates first.
AI_PROVIDER=disabled
# Supported provider modes: deepseek, qwen, or openai-compatible with supported HTTPS host.
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=12000
# USD/day; zero disables external processing. Also configure the private SQL budget.
AI_DAILY_BUDGET=0
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_PRICING_VERIFIED=false

# Local English OCR uses a browser worker and packaged assets; no server upload.
OCR_PROVIDER=browser-tesseract
# Large/non-English OCR workers are not configured in this release.
