# Optional dedicated Roadmaps backend; never use Campus/Workspace credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Current Qwen mode. Explicit disabled overrides automatic QWEN_* detection.
AI_PROVIDER=qwen-free-quota
QWEN_API_KEY=
QWEN_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
# Fail closed until an operator checks the actual account's Free Quota Only switch.
# These fields record that check; they do not themselves enable the vendor setting.
QWEN_FREE_QUOTA_ONLY_VERIFIED=false
QWEN_FREE_QUOTA_VERIFICATION_REFERENCE=
QWEN_FREE_QUOTA_VERIFIED_UNTIL=2027-01-28T16:00:00Z
# Conservative application token limit, NOT proof of remaining vendor free quota.
# Also configure private qwen_token_settings in the authorized dedicated database.
QWEN_DAILY_TOKEN_LIMIT=0
QWEN_ALLOW_ANONYMOUS_FREE_ONLY=false
QWEN_VERIFY_ON_DEPLOY=false
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=12000

# Other adapter modes remain inactive unless explicitly configured/authorized.
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=
AI_DAILY_BUDGET=0
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_PRICING_VERIFIED=false

# Local English browser OCR; no external vision subscription required.
OCR_PROVIDER=browser-tesseract
# Optional separate operator-only diagnostic secret (32+ characters).
# Unset keeps diagnostics closed (404). Never use the Qwen key here.
QWEN_DIAGNOSTICS_TOKEN=

# Living Tree optional enhancement entitlements; never inherit production attestation into Preview.
QWEN_COMPLEX_MODEL_FREE_VERIFIED=false
QWEN_EMBEDDING_FREE_VERIFIED=false
QWEN_EMBEDDING_MODEL=text-embedding-v4
