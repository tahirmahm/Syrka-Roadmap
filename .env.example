# Optional dedicated Roadmaps backend. Never use Campus/Workspace credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Core catalogue, document extraction, OCR, graph and practice work without AI.
# No model or pricing is assumed current. Verify official provider terms/rates first.
AI_PROVIDER=disabled
# Supported modes: qwen-token-plan (below), deepseek, openai-compatible.
# The qwen alias also uses Token Plan only; no DashScope Pay-As-You-Go fallback.
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=12000
# USD/day; zero disables external processing. Also configure the private SQL budget.
AI_DAILY_BUDGET=0
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_PRICING_VERIFIED=false

# Local English OCR uses a browser worker and packaged assets; no server upload.
OCR_PROVIDER=browser-tesseract
# Large/non-English OCR workers are not configured in this release.

# Prepaid Singapore QwenCloud Token Plan. Secrets remain server-side.
# Set AI_PROVIDER=qwen-token-plan only after verifying included models/terms.
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
# Exact included model ID from the account console or model discovery; no guess.
QWEN_MODEL=
# Conservative per-day reserved tokens, NOT a USD charge or the plan balance.
# Zero disables calls. Also set private qwen_token_settings.daily_token_limit.
QWEN_DAILY_TOKEN_LIMIT=0
